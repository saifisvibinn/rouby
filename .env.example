# Application
APP_NAME=Rouby
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-long-random-string
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://localhost","https://pos.local"]

# Database
POSTGRES_USER=rouby
POSTGRES_PASSWORD=rouby
POSTGRES_DB=rouby
DATABASE_URL=postgresql+asyncpg://rouby:rouby@localhost:5432/rouby
TEST_DATABASE_URL=postgresql+asyncpg://rouby:rouby@localhost:5432/rouby_test

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-long-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API
API_V1_PREFIX=/api/v1
